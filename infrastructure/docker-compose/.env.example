# Copy this file to .env and replace every placeholder with a local-only value.
# `.env` is gitignored. Production deployments must source equivalent values from their secret
# manager rather than from a file.
#
# The stock init-databases.sql creates each local bounded-context database but does not create
# per-service database roles. Therefore services use the bootstrap user/password below by default.
# Use distinct service values only after a migration/provisioning process creates those roles and
# grants them access to the corresponding database.
LIFEOS_POSTGRES_USER=
LIFEOS_POSTGRES_PASSWORD=
LIFEOS_POSTGRES_DB=lifeos

# Each bounded context uses the separately created local database below. The stock init script
# currently creates only the bootstrap role, so all local services use LIFEOS_POSTGRES_* until a
# separate provisioning migration creates least-privilege per-service roles.
IDENTITY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_identity
IDENTITY_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
IDENTITY_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
TASK_GOAL_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_task_goal
TASK_GOAL_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
TASK_GOAL_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
PROFILE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_profile
PROFILE_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
PROFILE_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_notification
NOTIFICATION_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
NOTIFICATION_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
CALENDAR_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_calendar
CALENDAR_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
CALENDAR_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
FINANCE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_finance
FINANCE_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
FINANCE_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
DOCUMENT_VAULT_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_document_vault
DOCUMENT_VAULT_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
DOCUMENT_VAULT_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
MEDIA_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_media
MEDIA_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
MEDIA_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
AI_ASSISTANT_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_ai_assistant
AI_ASSISTANT_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
AI_ASSISTANT_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
ANALYTICS_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_analytics
ANALYTICS_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
ANALYTICS_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
TRUST_LEDGER_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos_trust_ledger
TRUST_LEDGER_DATASOURCE_USERNAME=${LIFEOS_POSTGRES_USER}
TRUST_LEDGER_DATASOURCE_PASSWORD=${LIFEOS_POSTGRES_PASSWORD}
LIFEOS_TASK_GOAL_BASE_URL=http://localhost:8082
TRUST_LEDGER_TASK_GOAL_WORKLOAD_IDENTITY=trust-ledger-service
TRUST_LEDGER_MEDIA_ANCHOR_WORKLOAD_IDENTITY=media-service

# Start the optional local eventing profile to make this host endpoint available:
# docker compose --env-file infrastructure/docker-compose/.env -f infrastructure/docker-compose/docker-compose.yml --profile eventing up -d
LIFEOS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_ASSISTANT_AUDIT_OUTBOX_RELAY_ENABLED=false
TRUST_LEDGER_KAFKA_ENABLED=false
TRUST_LEDGER_PROOF_TOPIC=lifeos.document.proof.requested.v1
TRUST_LEDGER_KAFKA_GROUP=trust-ledger-document-proof-v1
TRUST_LEDGER_AI_AUDIT_KAFKA_ENABLED=false
TRUST_LEDGER_AI_AUDIT_TOPIC=lifeos.ai.audit.hash.requested.v1
TRUST_LEDGER_AI_AUDIT_KAFKA_GROUP=trust-ledger-ai-audit-v1
TRUST_LEDGER_BESU_ENABLED=false
TRUST_LEDGER_BESU_RPC_URL=http://localhost:8545
TRUST_LEDGER_BESU_PRIVATE_KEY=
TRUST_LEDGER_BESU_CONTRACT_ADDRESS=
TRUST_LEDGER_BESU_FUNCTION_NAME=anchorRoot
TRUST_LEDGER_BESU_CHAIN_ID=1337
TRUST_LEDGER_BESU_GAS_LIMIT=120000
TRUST_LEDGER_BESU_GAS_PRICE_WEI=1000000000
TRUST_LEDGER_BESU_REQUEST_TIMEOUT=5s
TRUST_LEDGER_BESU_RECEIPT_POLLING_INTERVAL=250ms
TRUST_LEDGER_BESU_RECEIPT_POLLING_ATTEMPTS=20
# Start the explicitly local-only node with:
# bash scripts/start-local-blockchain.sh
# Contract deployment remains a separate reviewed step; never put a production private key here.

# Optional GraphQL-to-gRPC dashboard fan-out. Keep disabled until the internal mTLS hosts,
# client certificates, trust bundle, and deployment workload tokens are provisioned.
LIFEOS_GATEWAY_DASHBOARD_GRPC_ENABLED=false
LIFEOS_GATEWAY_DASHBOARD_GRPC_DEADLINE=2s
LIFEOS_GATEWAY_TASK_GRPC_WORKLOAD_TOKEN=
LIFEOS_GATEWAY_CALENDAR_GRPC_WORKLOAD_TOKEN=
LIFEOS_GATEWAY_FINANCE_GRPC_WORKLOAD_TOKEN=
ANALYTICS_GRPC_WORKLOAD_TOKEN=
ANALYTICS_GRPC_ENABLED=false
ANALYTICS_GRPC_TLS_ENABLED=false
ANALYTICS_GRPC_CERTIFICATE_CHAIN=
ANALYTICS_GRPC_PRIVATE_KEY=
ANALYTICS_GRPC_TRUST_CERTIFICATE_COLLECTION=
LIFEOS_GATEWAY_TRUST_LEDGER_UPSTREAM=http://localhost:8087

# These deployment-only HMAC/workload values intentionally have no defaults. Generate distinct
# local values and never commit the resulting .env file.
CALENDAR_IDEMPOTENCY_SECRET=
CALENDAR_AUDIT_CLIENT_FINGERPRINT_SECRET=
IDENTITY_CALENDAR_WORKLOAD_TOKEN=
FINANCE_IDEMPOTENCY_SECRET=
FINANCE_AUDIT_CLIENT_FINGERPRINT_SECRET=
IDENTITY_FINANCE_WORKLOAD_TOKEN=
DOCUMENT_VAULT_IDEMPOTENCY_SECRET=
DOCUMENT_VAULT_AUDIT_CLIENT_FINGERPRINT_SECRET=
IDENTITY_DOCUMENT_VAULT_WORKLOAD_TOKEN=
IDENTITY_TRUST_LEDGER_WORKLOAD_TOKEN=
# The same workload credential is accepted by Task/Goal's completed-goal projection.
# Enable only with the optional eventing profile and a provisioned proof topic/ACL.
DOCUMENT_VAULT_PROOF_OUTBOX_RELAY_ENABLED=false
MEDIA_IDEMPOTENCY_SECRET=
MEDIA_AUDIT_CLIENT_FINGERPRINT_SECRET=
MEDIA_DEVELOPMENT_SIGNALING_SECRET=
IDENTITY_MEDIA_WORKLOAD_TOKEN=
MEDIA_TASK_GOAL_WORKLOAD_TOKEN=
MEDIA_TRUST_LEDGER_WORKLOAD_TOKEN=
TASK_GOAL_MEDIA_TOOL_WORKLOAD_TOKEN=
# Media defaults fail closed. For explicitly local-only upload/join exercises, set these modes to
# LOCAL_DEVELOPMENT (and set MEDIA_DEVELOPMENT_SIGNALING_SECRET) in an untracked .env file.
MEDIA_STORAGE_MODE=EXTERNAL_OBJECT_STORE_REQUIRED
MEDIA_LOCAL_STORAGE_ROOT=./var/media-objects
MEDIA_SIGNALING_MODE=EXTERNAL_SFU_REQUIRED
MEDIA_PROCESSING_MODE=EXTERNAL_WORKER_REQUIRED
MEDIA_PROCESSING_EXECUTABLE=ffmpeg
MEDIA_PROCESSING_TIMEOUT=60s
MEDIA_PROCESSING_MAX_CONCURRENT_JOBS=2
AI_ASSISTANT_AUDIT_HMAC_SECRET=
IDENTITY_AI_ASSISTANT_WORKLOAD_TOKEN=
IDENTITY_PASSKEY_RECOVERY_SECRET=
# Shared workload credential used by the confirmed AI task tool to call Task/Goal.
TASK_GOAL_AI_ASSISTANT_WORKLOAD_TOKEN=
FINANCE_AI_ASSISTANT_WORKLOAD_TOKEN=
PROFILE_AI_ASSISTANT_WORKLOAD_TOKEN=
ANALYTICS_AI_ASSISTANT_WORKLOAD_TOKEN=
AI_ASSISTANT_ANALYTICS_GATEWAY_PROOF_SECRET=${ANALYTICS_GATEWAY_PROOF_SECRET}
# Provider generation is fail-closed by default. Set OPENAI_COMPATIBLE only for a reviewed local
# or HTTPS deployment endpoint; never commit a provider API key here.
AI_ASSISTANT_PROVIDER_MODE=DISABLED
AI_ASSISTANT_PROVIDER_BASE_URL=http://localhost:11434/v1
AI_ASSISTANT_PROVIDER_COMPLETION_PATH=/chat/completions
AI_ASSISTANT_PROVIDER_API_KEY=
AI_ASSISTANT_PROVIDER_MODEL=llama3.2
AI_ASSISTANT_PROVIDER_MAX_RESPONSE_BYTES=262144
# Optional local vector grounding. Start with `--profile vector`; leave disabled for a fail-closed
# assistant. Production must provide a private Qdrant URL and API key through a secret manager.
QDRANT_ENABLED=false
DOCUMENT_VAULT_QDRANT_ENABLED=false
DOCUMENT_VAULT_OCR_ENABLED=false
DOCUMENT_VAULT_OCR_EXECUTABLE=tesseract
DOCUMENT_VAULT_OCR_TIMEOUT=5s
DOCUMENT_VAULT_OCR_MAX_OUTPUT_CHARACTERS=65536
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION=lifeos_documents_v1
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=32
QDRANT_MAX_RESULTS=8
QDRANT_MAX_CHUNKS_PER_DOCUMENT=64
QDRANT_MAX_CHUNK_CHARACTERS=1600
QDRANT_TIMEOUT=2s
# Optional encrypted AI conversation history. Start MongoDB with `--profile mongo`, generate a
# base64 AES-256 key, and set the enable flag only after reviewing retention/consent requirements.
AI_ASSISTANT_MONGODB_HISTORY_ENABLED=false
AI_ASSISTANT_MONGODB_URI=mongodb://localhost:27017/lifeos_ai_history
AI_ASSISTANT_MONGODB_DATABASE=lifeos_ai_history
AI_ASSISTANT_MONGODB_ENCRYPTION_KEY=
AI_ASSISTANT_MONGODB_COLLECTION=conversation_messages
AI_ASSISTANT_MONGODB_MAX_ENTRIES=100
AI_ASSISTANT_MONGODB_RETENTION_DAYS=30
AI_ASSISTANT_MONGODB_MAX_ENTRY_BYTES=32768
AI_ASSISTANT_MONGODB_CONNECT_TIMEOUT=2s
# Optional encrypted Profile journals/notes. Reuses the loopback Mongo profile for development;
# production must use an authenticated TLS deployment and a managed AES-256 key.
PROFILE_JOURNAL_MONGODB_ENABLED=false
PROFILE_JOURNAL_MONGODB_URI=mongodb://localhost:27017/lifeos_profile
PROFILE_JOURNAL_MONGODB_DATABASE=lifeos_profile
PROFILE_JOURNAL_MONGODB_COLLECTION=journal_entries
PROFILE_JOURNAL_MONGODB_ENCRYPTION_KEY=
PROFILE_JOURNAL_MAX_ENTRIES_PER_OWNER=10000
PROFILE_JOURNAL_MAX_CONTENT_BYTES=65536
PROFILE_JOURNAL_MAX_PAGE_SIZE=50
PROFILE_JOURNAL_MONGODB_TIMEOUT=2s
ANALYTICS_GATEWAY_PROOF_SECRET=
IDENTITY_ANALYTICS_WORKLOAD_TOKEN=
LIFEOS_GATEWAY_ANALYTICS_PROOF_SECRET=${ANALYTICS_GATEWAY_PROOF_SECRET}
